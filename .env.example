# Database reads and scraper writes. Leave both empty to use curated/demo mode.
DATABASE_URL="postgresql://user:password@host:5432/database?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/database"

# Required by /api/cron/scrape. Use a long random value in every deployed environment.
CRON_SECRET="replace-with-a-long-random-secret"

# Optional: local Chromium/Chrome executable used by the Xhunt scraper.
PUPPETEER_EXECUTABLE_PATH=""

# Optional: server-only key used by `npm run products:discover`.
TAVILY_API_KEY=""
